# Copy to .env on the server. docker compose reads it automatically.

# Required only when using the bundled Caddy profile. Must be a real DNS name
# pointing at this box.
WTP_HOSTNAME=pokedraw.example.com

# Certificate expiry notices are opt-in and are configured by editing the
# Caddyfile directly, not here — see the comment at the top of that file.
# (An empty `email` directive is a Caddy parse error, so it is not wired to an
# env var.)

# Leave blank to infer the Secure cookie flag from X-Forwarded-Proto (correct
# behind Caddy or a properly configured nginx). Set to 1 to force it on.
WTP_SECURE_COOKIES=

# Optional: pin the session signing key instead of letting the app generate one
# into /data/secret_key. Changing it logs everyone out.
# WTP_SECRET_KEY=
